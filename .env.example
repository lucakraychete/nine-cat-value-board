# ESPN league settings. Copy this file to .env (setup.sh does it for you).
# NEVER commit .env: ESPN_S2 and SWID are login cookies for your ESPN account.

# The number after leagueId= in your league URL
LEAGUE_ID=123456
# Season year as ESPN labels it (the 2025-26 season is 2026)
YEAR=2026
# Cookies, required for private leagues. See README for how to find them.
ESPN_S2=
SWID={XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}
# true = 8-cat league (no turnovers), false = full 9-cat
EXCLUDE_TO=true
